# Exactly two explicit device indices or GPU UUIDs already used by vLLM.
# Deliberately invalid placeholders: replace them only after read-only verification.
ALLOWED_GPU_IDS="REPLACE_GPU_A,REPLACE_GPU_B"

# Every PID in the existing vLLM service (frontend plus all GPU workers).
VLLM_PIDS="REPLACE_FRONTEND_AND_WORKER_PIDS"

# Existing service only. Must resolve syntactically to loopback.
VLLM_URL="http://127.0.0.1:8000"

# Unique, unused loopback port owned by this experiment.
GATEWAY_HOST="127.0.0.1"
GATEWAY_PORT="18181"

# Edit to a model name already served by the existing vLLM instance.
MODEL_NAME="existing-model-name"
PROMPT="Reply with the word ready."
MAX_TOKENS="8"

# Do not put the API key in this file. Export VLLM_API_KEY only in the shell
# that invokes run.sh. The key is forwarded in memory and is not logged.
