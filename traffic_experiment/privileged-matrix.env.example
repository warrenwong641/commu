# Root-owned configuration for the fixed one-GPU full matrix. The builder
# replaces @REPOSITORY_SHA@. Fill only the model revision and manifest digests.
# Never add credentials to this file.

LOCOMO_DATA_DIR="/nonexistent"
CAPTURE_INTERFACE="llmhost0"

VLLM_HOST="127.0.0.1"
VLLM_PORT="8000"
VLLM_SECONDARY_PORT="8001"
VLLM_MODEL="Qwen/Qwen3.5-9B"
VLLM_SERVED_MODEL_NAME="Qwen/Qwen3.5-9B"
VLLM_MODEL_REVISION=""
CUDA_VISIBLE_DEVICES="2"
PARALLEL_WORKERS="1"
VLLM_PORT_STEP="1"
TENSOR_PARALLEL_SIZE="1"
MAX_MODEL_LEN="65536"
GPU_MEMORY_UTILIZATION="0.90"
VLLM_BIN="/usr/bin/false"

COMPRESSOR_MODEL="NousResearch/Llama-2-7b-hf"
COMPRESSOR_DEVICE="cpu"
MANIFEST_PATH="artifacts/requests_32.jsonl"
SUMMARY_MANIFEST_PATH="artifacts/event_summaries_10.jsonl"
MANIFEST_SHA256=""
SUMMARY_MANIFEST_SHA256=""

RUNS_ROOT="/var/lib/commu-secure-matrix/@REPOSITORY_SHA@/runs"
RANDOM_SEED="42"
MAX_OUTPUT_TOKENS="4096"
SUMMARY_MAX_OUTPUT_TOKENS="4096"
REQUEST_TIMEOUT_SECONDS="900"
MAIN_REPETITIONS="3"
PROFILE="main"
OBSERVATION_SECONDS="900"
SUMMARY_OBSERVATION_SECONDS="900"
CAPTURE_STOP_ON_RESPONSE="true"
CAPTURE_STARTUP_DELAY_SECONDS="0.5"

CLIENT_NETNS="llm-client"
HOST_VETH="llmhost0"
CLIENT_VETH="llmclient0"
HOST_VETH_CIDR="10.200.0.1/24"
CLIENT_VETH_CIDR="10.200.0.2/24"
SECURE_PROXY_HOST="10.200.0.1"
CAPTURE_INTERFACE_OVERRIDE="llmclient0"
CADDY_RUN_DIR="/var/lib/commu-secure-matrix/@REPOSITORY_SHA@/caddy"

NETWORK_MTU="1500"
NETWORK_RTT_MS="40"
NETWORK_UPLINK_MBIT="20"
NETWORK_DOWNLINK_MBIT="50"
NETWORK_QUEUE_PACKETS="1000"
LAB_NETWORKS="baseline rtt realistic"
LINK_CALIBRATION_SECONDS="10"

LAB_QA_SAMPLES="32"
LAB_SUMMARY_SAMPLES="20"
LAB_REPETITIONS="3"
LAB_TRANSPORTS="tls13 http3"
LAB_WORKLOADS="qa summary"
CONNECTION_MODE="warm"

SESSION_TURNS="32"
SESSION_START_INTERVAL_SECONDS="0"
SESSION_BUDGET_SECONDS="30"
SESSION_SEGMENT_SECONDS="30"
SESSION_CONDITION="no_compression"

OPENROUTER_MODEL=""
OPENROUTER_PROVIDER=""
OPENROUTER_BASE_URL="https://openrouter.ai/api/v1"
GEMINI_MODEL=""
GEMINI_BASE_URL="https://generativelanguage.googleapis.com/v1beta"
