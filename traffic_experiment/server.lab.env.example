# Lab-server profile. Copy to server.lab.env; never commit the populated file.

# Dataset and capture
LOCOMO_DATA_DIR="/srv/commu/data/locomo"
CAPTURE_INTERFACE="llmhost0"

# Local model (one or two independent single-GPU workers). The GPU list is an
# ordered worker mapping and must contain exactly PARALLEL_WORKERS entries.
VLLM_HOST="127.0.0.1"
VLLM_PORT="8000"
VLLM_SECONDARY_PORT="8001"
VLLM_MODEL="Qwen/Qwen3.5-9B"
VLLM_SERVED_MODEL_NAME="Qwen/Qwen3.5-9B"
VLLM_MODEL_REVISION=""  # Fill with the exact Hugging Face commit for final runs.
# Never put LOCAL_VLLM_API_KEY in this file. Export it interactively in the
# invoking shell and unset it after the run.
CUDA_VISIBLE_DEVICES="0,1"
PARALLEL_WORKERS="2"
VLLM_PORT_STEP="1"
TENSOR_PARALLEL_SIZE="1"
MAX_MODEL_LEN="65536"
GPU_MEMORY_UTILIZATION="0.90"
VLLM_BIN="/opt/vllm/bin/vllm"
# For a gated/private model, export HF_TOKEN only in the invoking process.

# Frozen compression artifacts
COMPRESSOR_MODEL="NousResearch/Llama-2-7b-hf"
# Manifest preparation defaults to the reproducible CPU-only compression lock.
# Do not select CUDA without a separate approved environment and smoke test.
# Approved GPU use must bind GPU_COMPRESSOR_APPROVED_PYTHON to the exact
# COMPRESSION_PYTHON interpreter. Leave both unset for the CPU default.
COMPRESSOR_DEVICE="cpu"
MANIFEST_PATH="artifacts/requests_32.jsonl"
SUMMARY_MANIFEST_PATH="artifacts/event_summaries_10.jsonl"
# REQUIRED for preflight: copy the exact SHA-256 values printed by the
# preparation/bundle workflow. Preflight rejects missing or changed artifacts.
MANIFEST_SHA256=""
SUMMARY_MANIFEST_SHA256=""

# Reproducible generation and resumable runs
# Never reuse a run root after changing worker count, GPU order, or GPU UUIDs.
RUNS_ROOT="runs/lab-two-gpu-0-1"
RANDOM_SEED="42"
MAX_OUTPUT_TOKENS="4096"
SUMMARY_MAX_OUTPUT_TOKENS="4096"
REQUEST_TIMEOUT_SECONDS="900"
MAIN_REPETITIONS="3"
PROFILE="main"

# Per-request captures end after the complete streamed response. The duration
# below is a failure safety ceiling, not the 30-second analysis window.
OBSERVATION_SECONDS="900"
SUMMARY_OBSERVATION_SECONDS="900"
CAPTURE_STOP_ON_RESPONSE="true"
CAPTURE_STARTUP_DELAY_SECONDS="0.5"

# Direct client/server topology: no SSH and no external public-IP dependency.
CLIENT_NETNS="llm-client"
HOST_VETH="llmhost0"
CLIENT_VETH="llmclient0"
HOST_VETH_CIDR="10.200.0.1/24"
CLIENT_VETH_CIDR="10.200.0.2/24"
SECURE_PROXY_HOST="10.200.0.1"
# The runner executes inside CLIENT_NETNS, so dumpcap must use the interface
# visible inside that namespace rather than the host-side veth.
CAPTURE_INTERFACE_OVERRIDE="llmclient0"
CADDY_RUN_DIR="runs/lab/caddy"
# Stable service ownership state; do not place this under topology-specific
# RUNS_ROOT because teardown must remain discoverable after a mode switch.
PHYSICAL_LISTENER_STATE_ROOT="runs/service_state/physical_listener"

# Controlled link. baseline has no delay/rate qdisc; rtt adds delay only;
# realistic adds both delay and asymmetric capacity.
NETWORK_MTU="1500"
NETWORK_RTT_MS="40"
NETWORK_UPLINK_MBIT="20"
NETWORK_DOWNLINK_MBIT="50"
NETWORK_QUEUE_PACKETS="1000"
LAB_NETWORKS="baseline rtt realistic"
LINK_CALIBRATION_SECONDS="10"

# Workload matrix
LAB_QA_SAMPLES="32"
LAB_SUMMARY_SAMPLES="20"
LAB_REPETITIONS="3"
LAB_TRANSPORTS="tls13 http3"
LAB_WORKLOADS="qa summary"
CONNECTION_MODE="warm"

# Thirty-second closed-loop session profile. A request admitted before the
# deadline is allowed to finish.
SESSION_TURNS="32"
SESSION_START_INTERVAL_SECONDS="0"
SESSION_BUDGET_SECONDS="30"
SESSION_SEGMENT_SECONDS="30"
SESSION_CONDITION="no_compression"

# External APIs remain disabled during the controlled local experiment. If a
# separate validation run needs them, export OPENROUTER_API_KEY or
# GEMINI_API_KEY only in the invoking process; never add them to this file.
OPENROUTER_MODEL=""
OPENROUTER_PROVIDER=""
OPENROUTER_BASE_URL="https://openrouter.ai/api/v1"
GEMINI_MODEL=""
GEMINI_BASE_URL="https://generativelanguage.googleapis.com/v1beta"
