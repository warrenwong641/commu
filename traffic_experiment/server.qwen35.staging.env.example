# Credential-free Qwen3.5 lab-migration staging values.
#
# This tracked file is for static review only. It is not an active server env
# file and must not be sourced by launch scripts. Replace the two explicit
# placeholders only after the corresponding lab-server paths have been staged.

STAGING_ONLY=1
VLLM_HOST="127.0.0.1"
VLLM_PORT="8000"
VLLM_SECONDARY_PORT="8001"
VLLM_PORT_STEP="1"

VLLM_MODEL="Qwen/Qwen3.5-9B"
