CUDA_VISIBLE_DEVICES="0,1"
PARALLEL_WORKERS="2"
TENSOR_PARALLEL_SIZE="1"
MAX_MODEL_LEN="65536"
MAX_OUTPUT_TOKENS="4096"
SUMMARY_MAX_OUTPUT_TOKENS="4096"

VLLM_BIN="__STAGED_VLLM_BIN__"
RUNNER_PYTHON="__STAGED_RUNNER_PYTHON__"
