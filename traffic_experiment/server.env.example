# Copy this file to server.env after moving the repository to the lab server.
# Fill the two REQUIRED blanks before running anything.

# REQUIRED: directory containing the downloaded LoCoMo JSON file(s).
LOCOMO_DATA_DIR=""

# REQUIRED: interface observed by dumpcap. Examples: lo, eth0, br-xxxx.
# Run "dumpcap -D" to list interfaces.
CAPTURE_INTERFACE=""

# Local model server
VLLM_HOST="127.0.0.1"
VLLM_PORT="8000"
VLLM_SECONDARY_PORT="8001"
VLLM_MODEL="Qwen/Qwen3.5-9B"
VLLM_SERVED_MODEL_NAME="Qwen/Qwen3.5-9B"
VLLM_MODEL_REVISION=""  # REQUIRED for the final run; use the exact Hugging Face commit SHA.
# Never put LOCAL_VLLM_API_KEY in this file. Export it interactively in the
# invoking shell and unset it after the run.

# GPU/server settings: edit these for the lab machine.
CUDA_VISIBLE_DEVICES="0"
TENSOR_PARALLEL_SIZE="1"
# Supported modes are one GPU/one worker or two distinct GPUs/two workers.
# The ordered GPU list must contain exactly PARALLEL_WORKERS entries.
PARALLEL_WORKERS="1"
VLLM_PORT_STEP="1"
MAX_MODEL_LEN="65536"
GPU_MEMORY_UTILIZATION="0.94"
VLLM_BIN="vllm"

# For a gated/private model, export HF_TOKEN only in the invoking process.

# LongLLMLingua compressor. It is used before vLLM starts.
COMPRESSOR_MODEL="NousResearch/Llama-2-7b-hf"
# The reproducible .venv-compression lock is CPU-only. GPU compression requires
# a separate approved environment and compatibility smoke test. For approved
# GPU use, GPU_COMPRESSOR_APPROVED_PYTHON must name the same interpreter as
# COMPRESSION_PYTHON. Do not set either approval variable for the CPU default.
COMPRESSOR_DEVICE="cpu"

# Experiment paths and settings
MANIFEST_PATH="artifacts/requests_32.jsonl"
MANIFEST_SHA256=""  # REQUIRED for final measured runs.
# Use a new immutable root whenever worker count or GPU mapping changes.
RUNS_ROOT="runs/one-gpu-0"
RANDOM_SEED="42"
OBSERVATION_SECONDS="900"
MAX_OUTPUT_TOKENS="4096"
REQUEST_TIMEOUT_SECONDS="900"
CAPTURE_FILTER="tcp port 8000"
# For long outputs, capture the complete response and use this only as a
# safety ceiling. The 30-second session admission rule remains separate.
CAPTURE_STOP_ON_RESPONSE="true"
CAPTURE_MAX_SECONDS="900"
MAIN_REPETITIONS="3"  # Technical repeats; samples remain the independent units.

# Secure local transport profiles
CADDY_RUN_DIR="runs/caddy"
SUMMARY_MANIFEST_PATH="artifacts/event_summaries_10.jsonl"
SUMMARY_MANIFEST_SHA256=""  # REQUIRED for final measured runs.
SUMMARY_CONVERSATIONS="10"
SUMMARY_CONDITIONS="no_compression longllmlingua_2x longllmlingua_4x"
SUMMARY_MAX_OUTPUT_TOKENS="4096"
SUMMARY_OBSERVATION_SECONDS="900"

# Controlled network link. Antonio et al. do not state an MTU, but their released
# controlled traces contain IP packets up to 1500 bytes.
SECURE_PROXY_HOST="localhost"
CLIENT_NETNS=""
CAPTURE_INTERFACE_OVERRIDE=""
NETWORK_MTU="1500"
NETWORK_RTT_MS="40"
NETWORK_UPLINK_MBIT="20"
NETWORK_DOWNLINK_MBIT="50"
NETWORK_QUEUE_PACKETS="1000"
CONNECTION_MODE="warm"
SESSION_TURNS="2"
SESSION_START_INTERVAL_SECONDS="0"
SESSION_BUDGET_SECONDS="30"
SESSION_SEGMENT_SECONDS="30"
SESSION_CONDITION="no_compression"

# External API profiles. Export provider keys only in the invoking process;
# never add OPENROUTER_API_KEY or GEMINI_API_KEY to this file.
OPENROUTER_MODEL=""       # Pin an exact model slug before the pilot.
OPENROUTER_PROVIDER=""    # Required: fallback is disabled by the runner.
OPENROUTER_BASE_URL="https://openrouter.ai/api/v1"
GEMINI_MODEL=""           # Pin a stable model ID before the pilot.
GEMINI_BASE_URL="https://generativelanguage.googleapis.com/v1beta"

# Set a profile when invoking 05_run_profile.sh: pilot, main, or robustness.
PROFILE="pilot"
