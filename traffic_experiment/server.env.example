# Copy this file to server.env after moving the repository to the lab server.
# Fill the two REQUIRED blanks before running anything.

# REQUIRED: directory containing the downloaded LoCoMo JSON file(s).
LOCOMO_DATA_DIR=""

# REQUIRED: interface observed by dumpcap. Examples: lo, eth0, br-xxxx.
# Run "dumpcap -D" to list interfaces.
CAPTURE_INTERFACE=""

# Local model server
VLLM_HOST="127.0.0.1"
VLLM_PORT="8000"
VLLM_MODEL="Qwen/Qwen3.5-9B"
VLLM_SERVED_MODEL_NAME="Qwen/Qwen3.5-9B"
VLLM_MODEL_REVISION=""  # REQUIRED for the final run; use the exact Hugging Face commit SHA.
LOCAL_VLLM_API_KEY="local-test-key"

# GPU/server settings: edit these for the lab machine.
CUDA_VISIBLE_DEVICES="0"
TENSOR_PARALLEL_SIZE="1"
PARALLEL_WORKERS="2"
VLLM_PORT_STEP="1"
MAX_MODEL_LEN="65536"
GPU_MEMORY_UTILIZATION="0.94"
VLLM_BIN="vllm"

# Optional Hugging Face token, needed only for a gated/private model.
HF_TOKEN=""

# LongLLMLingua compressor. It is used before vLLM starts.
COMPRESSOR_MODEL="NousResearch/Llama-2-7b-hf"
COMPRESSOR_DEVICE="cuda"

# Experiment paths and settings
MANIFEST_PATH="artifacts/requests_32.jsonl"
RUNS_ROOT="runs"
RANDOM_SEED="42"
OBSERVATION_SECONDS="30"
MAX_OUTPUT_TOKENS="256"
REQUEST_TIMEOUT_SECONDS="120"
CAPTURE_FILTER="tcp port 8000"

# Set a profile when invoking 05_run_profile.sh: pilot, main, or robustness.
PROFILE="pilot"
