# Credential-free vLLM service profile for two independent workers.
# Copy to an untracked, user-owned file and replace every site-specific value.
# Keep comments on separate lines: the switcher intentionally rejects inline
# comments, shell expansion, commands, credentials, and unknown assignments.

VLLM_HOST="127.0.0.1"
VLLM_PORT="8000"
VLLM_SECONDARY_PORT="8001"
VLLM_PORT_STEP="1"
VLLM_MODEL="Qwen/Qwen3.5-9B"
VLLM_SERVED_MODEL_NAME="Qwen/Qwen3.5-9B"
VLLM_MODEL_REVISION="replace-with-exact-model-commit"
CUDA_VISIBLE_DEVICES="0,1"
PARALLEL_WORKERS="2"
TENSOR_PARALLEL_SIZE="1"
MAX_MODEL_LEN="65536"
GPU_MEMORY_UTILIZATION="0.90"
VLLM_BIN="/absolute/path/to/vllm"
export LD_LIBRARY_PATH="/absolute/path/to/cuda/lib64"
RUNS_ROOT="/absolute/path/to/fresh/dual-worker-run-root"
